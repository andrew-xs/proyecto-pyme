diff --git a/package.json b/package.json
new file mode 100644
index 0000000000000000000000000000000000000000..7d280b14291f59067ae80f84c3289eb69bdab299
--- /dev/null
+++ b/package.json
@@ -0,0 +1,23 @@
+{
+  "name": "cumplepyme",
+  "private": true,
+  "version": "0.1.0",
+  "packageManager": "pnpm@9.12.1",
+  "workspaces": [
+    "apps/*",
+    "packages/*"
+  ],
+  "scripts": {
+    "dev": "pnpm db:up && pnpm db:migrate && pnpm db:seed && concurrently -n api,web \"pnpm --filter @cumplepyme/api dev\" \"pnpm --filter @cumplepyme/web dev\"",
+    "db:up": "docker compose -f infra/docker-compose.yml up -d",
+    "db:down": "docker compose -f infra/docker-compose.yml down -v",
+    "db:migrate": "pnpm --filter @cumplepyme/api prisma:migrate",
+    "db:seed": "pnpm --filter @cumplepyme/api prisma:seed",
+    "build": "pnpm --filter @cumplepyme/api build && pnpm --filter @cumplepyme/web build",
+    "lint": "echo 'lint not configured'",
+    "test": "echo 'tests not configured'"
+  },
+  "devDependencies": {
+    "concurrently": "^8.2.2"
+  }
+}
